# Firebase Configuration
# These are already configured in firebase.json for Cloud Functions
# But can be overridden here for local emulation

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@tutor.ke

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_ACCOUNT_REFERENCE=TUTORKE
MPESA_TRANSACTION_DESC=Tutor Kenya Course Enrollment
MPESA_SHORT_CODE=174379
MPESA_SECURITY_TOKEN=your-mpesa-security-token

# Environment
NODE_ENV=production

# Logging
LOG_LEVEL=info
